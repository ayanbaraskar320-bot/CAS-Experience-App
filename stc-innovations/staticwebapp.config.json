{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/snapshots/*", "/*.{png,jpg,jpeg,gif,svg,ico,css,js}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff"
  }
}
